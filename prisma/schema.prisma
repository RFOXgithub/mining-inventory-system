model StageFile {
  id         String   @id @default(uuid()) @db.Uuid
  requestKey String   @unique @db.Uuid
  plantId    String   @db.Uuid
  domain     String
  ownerId    String   @db.Uuid
  sourceId   String?  @db.Uuid
  name       String
  mime       String
  size       Int
  sha256     String
  content    Bytes
  createdAt  DateTime @default(now())

  @@index([plantId, domain, sourceId])
}
