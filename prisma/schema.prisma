generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  WAITING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum StockDirection {
  IN
  OUT
}

enum InventoryType {
  RECEIVING
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALES_DELIVERY
  TRANSFER
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  MAINTENANCE_USAGE
}

enum StockpileType {
  RAW_MATERIAL
  FINISHED_GOODS
  WASTE
  TEMPORARY
}

enum StockpileStatus {
  ACTIVE
  NEAR_CAPACITY
  FULL
  INACTIVE
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique
  passwordHash      String
  name              String
  username          String?          @unique
  employeeCode      String?
  department        String?
  status            String           @default("ACTIVE")
  lastLoginAt       DateTime?
  lockedUntil       DateTime?
  active            Boolean          @default(true)
  functions         AdminFunction[]  @default([])
  actionPermissions String[]         @default([])
  allPlants         Boolean          @default(false)
  sessionVersion    Int              @default(0)
  plantScopes       UserPlantScope[]
  roles             UserRole[]
  audits            AuditLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique
  name           String
  category       String
  unit           String                 @default("TON")
  sellingPrice   Decimal                @db.Decimal(18, 2)
  minimumStock   Decimal                @default(0) @db.Decimal(18, 3)
  active         Boolean                @default(true)
  inventory      InventoryTransaction[]
  outputs        ProductionOutput[]
  stockpiles     Stockpile[]
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  catalogItem    CatalogItem?
}

model Material {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  name        String
  unit        String                 @default("TON")
  active      Boolean                @default(true)
  inventory   InventoryTransaction[]
  inputs      ProductionInput[]
  stockpiles  Stockpile[]
  catalogItem CatalogItem?
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  companyName  String
  pic          String
  phone        String
  email        String?
  address      String
  npwp         String?
  creditLimit  Decimal      @db.Decimal(18, 2)
  paymentTerms Int
  customerType String
  active       Boolean      @default(true)
  orders       SalesOrder[]
  quotations   Quotation[]
  invoices     Invoice[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
}

model Vehicle {
  id               String                   @id @default(uuid()) @db.Uuid
  code             String                   @unique
  plateNumber      String                   @unique
  vehicleType      String
  brand            String?
  model            String?
  year             Int?
  capacity         Decimal                  @db.Decimal(10, 2)
  ownership        String
  vendor           String?
  assignedDriverId String?                  @db.Uuid
  stnkExpiry       DateTime
  kirExpiry        DateTime
  insuranceExpiry  DateTime?
  status           String
  weighings        WeighbridgeTransaction[]
  deliveries       DeliveryOrder[]
  assignedDriver   Driver?                  @relation("VehicleAssignedDriver", fields: [assignedDriverId], references: [id])
  maintenances     VehicleMaintenance[]
}

model Driver {
  id               String                   @id @default(uuid()) @db.Uuid
  code             String                   @unique
  name             String
  phone            String
  licenseNumber    String                   @unique
  licenseType      String
  licenseExpiry    DateTime
  active           Boolean                  @default(true)
  weighings        WeighbridgeTransaction[]
  deliveries       DeliveryOrder[]
  assignedVehicles Vehicle[]                @relation("VehicleAssignedDriver")
}

model VehicleMaintenance {
  id          String    @id @default(uuid()) @db.Uuid
  vehicleId   String    @db.Uuid
  description String
  status      String    @default("SCHEDULED")
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  cost        Decimal   @default(0) @db.Decimal(18, 2)
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([vehicleId, status, scheduledAt])
}

model Stockpile {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique
  name            String
  type            StockpileType
  location        String
  maximumCapacity Decimal                @default(0) @db.Decimal(18, 3)
  minimumStock    Decimal                @default(0) @db.Decimal(18, 3)
  unit            String                 @default("TON")
  status          StockpileStatus        @default(ACTIVE)
  notes           String?
  productId       String?                @db.Uuid
  materialId      String?                @db.Uuid
  product         Product?               @relation(fields: [productId], references: [id])
  material        Material?              @relation(fields: [materialId], references: [id])
  opnames         StockOpname[]
  inventory       InventoryTransaction[]
  receivingItems  ReceivingItem[]
  locationMaster  PlantLocation?
}

enum AdminFunction {
  PC
  FINANCE
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum PlantKind {
  SC
  BP
  AMP
}

enum LocationKind {
  STOCKPILE
  WAREHOUSE
  TANK
  QUARRY
}

enum CatalogKind {
  MATERIAL
  PRODUCT
  SERVICE
}

enum UomDimension {
  UNKNOWN
  MASS
  VOLUME
  COUNT
  TIME
  SERVICE
}

model Plant {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique
  name               String
  kind               PlantKind
  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String             @db.Uuid
  updatedBy          String?            @db.Uuid
  verifiedBy         String?            @db.Uuid
  verifiedAt         DateTime?
  version            Int                @default(1)
  locations          PlantLocation[]
  userScopes         UserPlantScope[]
  items              CatalogItemPlant[]
  stockPeriods       StockPeriod[]
  operationalRuns    OperationalRun[]
  operationalConfigs OperationalConfig[]
  commerceConfigs    CommerceConfig[]
  commerceRecords    CommerceRecord[]
  financialConfigs   FinancialConfig[]
  financialRecords   FinancialRecord[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model UserPlantScope {
  userId  String @db.Uuid
  plantId String @db.Uuid
  user    User   @relation(fields: [userId], references: [id])
  plant   Plant  @relation(fields: [plantId], references: [id])

  @@id([userId, plantId])
}

model PlantLocation {
  id                 String             @id @default(uuid()) @db.Uuid
  plantId            String             @db.Uuid
  code               String
  name               String
  kind               LocationKind
  stockpileId        String?            @unique @db.Uuid
  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String             @db.Uuid
  updatedBy          String?            @db.Uuid
  verifiedBy         String?            @db.Uuid
  verifiedAt         DateTime?
  version            Int                @default(1)
  plant              Plant              @relation(fields: [plantId], references: [id])
  stockpile          Stockpile?         @relation(fields: [stockpileId], references: [id])
  stockLines         StockDocumentLine[] @relation("StockSourceLocation")
  stockDestinations  StockDocumentLine[] @relation("StockDestinationLocation")
  openingClaims      StockOpeningClaim[]
  stockEntries       StockLedgerEntry[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([plantId, code])
}

model Uom {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique
  name               String
  dimension          UomDimension
  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String?            @db.Uuid
  verifiedBy         String?            @db.Uuid
  createdAt          DateTime           @default(now())
  items              CatalogItem[]
  conversionsFrom    UomConversion[]    @relation("ConversionFrom")
  conversionsTo      UomConversion[]    @relation("ConversionTo")
  stockEntries       StockLedgerEntry[]
}

model CatalogItem {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String
  name               String
  kind               CatalogKind
  category           String
  specification      String?
  primaryUomId       String             @db.Uuid
  legacyProductId    String?            @unique @db.Uuid
  legacyMaterialId   String?            @unique @db.Uuid
  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String?            @db.Uuid
  updatedBy          String?            @db.Uuid
  verifiedBy         String?            @db.Uuid
  verifiedAt         DateTime?
  version            Int                @default(1)
  primaryUom         Uom                @relation(fields: [primaryUomId], references: [id])
  legacyProduct      Product?           @relation(fields: [legacyProductId], references: [id])
  legacyMaterial     Material?          @relation(fields: [legacyMaterialId], references: [id])
  aliases            ItemAlias[]
  conversions        UomConversion[]
  plants             CatalogItemPlant[]
  stockLines         StockDocumentLine[]
  stockEntries       StockLedgerEntry[]
  openingClaims      StockOpeningClaim[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([kind, code])
}

model CatalogItemPlant {
  itemId  String      @db.Uuid
  plantId String      @db.Uuid
  item    CatalogItem @relation(fields: [itemId], references: [id])
  plant   Plant       @relation(fields: [plantId], references: [id])

  @@id([itemId, plantId])
}

model ItemAlias {
  id                 String             @id @default(uuid()) @db.Uuid
  itemId             String             @db.Uuid
  name               String
  normalizedName     String
  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String             @db.Uuid
  verifiedBy         String?            @db.Uuid
  verifiedAt         DateTime?
  item               CatalogItem        @relation(fields: [itemId], references: [id])

  @@unique([itemId, normalizedName])
}

model UomConversion {
  id                 String             @id @default(uuid()) @db.Uuid
  itemId             String             @db.Uuid
  fromUomId          String             @db.Uuid
  toUomId            String             @db.Uuid
  factor             Decimal            @db.Decimal(24, 12)
  version            Int
  effectiveFrom      DateTime
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String?
  createdBy          String             @db.Uuid
  verifiedBy         String?            @db.Uuid
  verifiedAt         DateTime?
  item               CatalogItem        @relation(fields: [itemId], references: [id])
  fromUom            Uom                @relation("ConversionFrom", fields: [fromUomId], references: [id])
  toUom              Uom                @relation("ConversionTo", fields: [toUomId], references: [id])

  @@unique([itemId, fromUomId, toUomId, version])
}

enum StockDocumentKind {
  DELIVERY
  PRODUCTION
  BLENDING
  FUEL_USAGE
  RECEIPT
  TRANSFER
  OPENING
  LEGACY_IMPORT
  OPNAME
  ADJUSTMENT
  INTERNAL_ISSUE
  REVERSAL
}

enum StockDocumentStatus {
  SUBMITTED
  POSTED
  REJECTED
  REVERSED
}

model StockPeriod {
  id           String @id @default(uuid()) @db.Uuid
  plantId      String @db.Uuid
  month        String
  closed       Boolean @default(false)
  requestedBy  String? @db.Uuid
  requestClose Boolean?
  reason       String?
  financeBy    String? @db.Uuid
  evidence     String?
  approvedBy   String? @db.Uuid
  reconciliationHash String?
  version      Int @default(1)
  plant        Plant @relation(fields: [plantId], references: [id])
  @@unique([plantId, month])
}

model StockDocument {
  id            String @id @default(uuid()) @db.Uuid
  number        String @unique
  kind          StockDocumentKind
  status        StockDocumentStatus @default(SUBMITTED)
  requestKey    String @unique @db.Uuid
  payloadHash   String
  effectiveAt   DateTime
  reason        String
  evidence      String
  sourceName    String?
  checksum      String?
  sourceSnapshot Json?
  makerId       String @db.Uuid
  financeBy     String? @db.Uuid
  financeEvidence String?
  approvedBy    String? @db.Uuid
  approvedAt    DateTime?
  reversalOfId  String? @unique @db.Uuid
  version       Int @default(1)
  lines         StockDocumentLine[]
  entries       StockLedgerEntry[]
  openingClaims StockOpeningClaim[]
  dependencies  StockDependency[] @relation("StockDependencySource")
  dependents    StockDependency[] @relation("StockDependencyTarget")
  reversalOf    StockDocument? @relation("StockReversal", fields: [reversalOfId], references: [id])
  reversal      StockDocument? @relation("StockReversal")
  createdAt     DateTime @default(now())
  @@index([kind, createdAt])
  operationalRun OperationalRun?
  commerceRecord CommerceRecord?
}

// Additive commercial sources; legacy quotation/order/delivery rows remain archives.
model CommerceConfig {
  id             String @id @default(uuid()) @db.Uuid
  requestKey     String @unique @db.Uuid
  payloadHash    String
  plantId        String @db.Uuid
  kind           String
  code           String
  revision       Int
  effectiveFrom  DateTime
  payload        Json
  evidence       String
  makerId        String @db.Uuid
  verificationStatus VerificationStatus @default(UNVERIFIED)
  pcBy           String? @db.Uuid
  pcEvidence     String?
  financeBy      String? @db.Uuid
  financeEvidence String?
  verifiedBy     String? @db.Uuid
  verifiedAt     DateTime?
  verificationEvidence String?
  createdAt      DateTime @default(now())
  plant          Plant @relation(fields: [plantId], references: [id])
  @@unique([plantId, kind, code, revision])
  @@index([plantId, kind, verificationStatus])
}

model CommerceRecord {
  id             String @id @default(uuid()) @db.Uuid
  number         String @unique
  requestKey     String @unique @db.Uuid
  payloadHash    String
  kind           String
  plantId        String @db.Uuid
  effectiveAt    DateTime
  status         String @default("DRAFT")
  payload        Json
  snapshot       Json?
  completion     Json?
  completionHash String?
  version        Int @default(1)
  revision       Int @default(1)
  makerId        String @db.Uuid
  submitterId    String? @db.Uuid
  verifierId     String? @db.Uuid
  approverId     String? @db.Uuid
  posterId       String? @db.Uuid
  decisionEvidence String?
  rootId         String @db.Uuid
  previousId     String? @db.Uuid
  parentId       String? @db.Uuid
  poId           String? @db.Uuid
  stockDocumentId String? @unique @db.Uuid
  createdAt      DateTime @default(now())
  plant          Plant @relation(fields: [plantId], references: [id])
  root           CommerceRecord @relation("CommerceRoot", fields: [rootId], references: [id])
  versions       CommerceRecord[] @relation("CommerceRoot")
  previous       CommerceRecord? @relation("CommercePrevious", fields: [previousId], references: [id])
  amendments     CommerceRecord[] @relation("CommercePrevious")
  parent         CommerceRecord? @relation("CommerceParent", fields: [parentId], references: [id])
  children       CommerceRecord[] @relation("CommerceParent")
  po             CommerceRecord? @relation("CommercePO", fields: [poId], references: [id])
  orders         CommerceRecord[] @relation("CommercePO")
  stockDocument  StockDocument? @relation(fields: [stockDocumentId], references: [id])
  fulfillments   CommerceFulfillment[] @relation("FulfillmentDelivery")
  orderFulfillments CommerceFulfillment[] @relation("FulfillmentSO")
  poFulfillments  CommerceFulfillment[] @relation("FulfillmentPO")
  billingLines   FinancialInvoiceLine[]
  @@unique([rootId, revision])
  @@index([plantId, kind, effectiveAt, status])
}

model CommerceFulfillment {
  id             String @id @default(uuid()) @db.Uuid
  deliveryId     String @db.Uuid
  salesOrderId   String @db.Uuid
  poVersionId    String? @db.Uuid
  poRootId       String? @db.Uuid
  orderLineKey   String @db.Uuid
  poLineKey      String? @db.Uuid
  itemId         String @db.Uuid
  uomId          String @db.Uuid
  quantity       Decimal @db.Decimal(24, 6)
  effectiveAt    DateTime
  actorId        String @db.Uuid
  delivery       CommerceRecord @relation("FulfillmentDelivery", fields: [deliveryId], references: [id])
  salesOrder     CommerceRecord @relation("FulfillmentSO", fields: [salesOrderId], references: [id])
  poVersion      CommerceRecord? @relation("FulfillmentPO", fields: [poVersionId], references: [id])
  @@unique([deliveryId, orderLineKey])
  @@index([salesOrderId, orderLineKey])
  @@index([poRootId, poLineKey])
}

model FinancialConfig {
  id             String @id @default(uuid()) @db.Uuid
  requestKey     String @unique @db.Uuid
  payloadHash    String
  plantId        String @db.Uuid
  kind           String
  code           String
  revision       Int
  effectiveFrom  DateTime
  payload        Json
  evidence       String
  makerId        String @db.Uuid
  financeBy      String? @db.Uuid
  financeEvidence String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedBy     String? @db.Uuid
  verificationEvidence String?
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  plant          Plant @relation(fields: [plantId], references: [id])
  @@unique([plantId, kind, code, revision])
  @@index([plantId, kind, verificationStatus])
}

model FinancialRecord {
  id             String @id @default(uuid()) @db.Uuid
  number         String @unique
  requestKey     String @unique @db.Uuid
  payloadHash    String
  kind           String
  plantId        String @db.Uuid
  effectiveAt    DateTime
  customerCode   String?
  projectCode    String?
  currency       String?
  status         String @default("DRAFT")
  payload        Json
  snapshot       Json?
  dueDate        String?
  makerId        String @db.Uuid
  submitterId    String? @db.Uuid
  verifierId     String? @db.Uuid
  posterId       String? @db.Uuid
  decisionEvidence String?
  version        Int @default(1)
  targetId       String? @db.Uuid
  target         FinancialRecord? @relation("FinancialCorrection", fields: [targetId], references: [id])
  corrections    FinancialRecord[] @relation("FinancialCorrection")
  plant          Plant @relation(fields: [plantId], references: [id])
  lines          FinancialInvoiceLine[]
  events         FinancialEvent[] @relation("FinancialEventSource")
  invoiceEvents  FinancialEvent[] @relation("FinancialEventInvoice")
  receiptEvents  FinancialEvent[] @relation("FinancialEventReceipt")
  createdAt      DateTime @default(now())
  @@index([plantId, kind, effectiveAt, status])
  @@index([customerCode, currency])
}

model FinancialInvoiceLine {
  id             String @id @default(uuid()) @db.Uuid
  invoiceId      String @db.Uuid
  deliveryId     String @db.Uuid
  sourceKey      String @db.Uuid
  role           String
  quantity       Decimal @db.Decimal(24, 6)
  unitPrice      Decimal @db.Decimal(24, 2)
  amount         Decimal @db.Decimal(24, 2)
  sourceSnapshot Json
  invoice        FinancialRecord @relation(fields: [invoiceId], references: [id])
  delivery       CommerceRecord @relation(fields: [deliveryId], references: [id])
  @@unique([invoiceId, deliveryId, sourceKey, role])
  @@index([deliveryId, sourceKey])
}

model FinancialEvent {
  id             String @id @default(uuid()) @db.Uuid
  sequence       BigInt @unique @default(autoincrement())
  eventKey       String @unique
  recordId       String @db.Uuid
  invoiceId      String? @db.Uuid
  receiptId      String? @db.Uuid
  kind           String
  amount         Decimal @db.Decimal(24, 2)
  effectiveAt    DateTime
  actorId        String @db.Uuid
  reversalOfId   String? @unique @db.Uuid
  source         FinancialRecord @relation("FinancialEventSource", fields: [recordId], references: [id])
  invoice        FinancialRecord? @relation("FinancialEventInvoice", fields: [invoiceId], references: [id])
  receipt        FinancialRecord? @relation("FinancialEventReceipt", fields: [receiptId], references: [id])
  reversalOf     FinancialEvent? @relation("FinancialEventReversal", fields: [reversalOfId], references: [id])
  reversal       FinancialEvent? @relation("FinancialEventReversal")
  createdAt      DateTime @default(now())
  @@index([invoiceId, effectiveAt])
  @@index([receiptId, effectiveAt])
}

enum OperationalStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  POSTED
  REJECTED
  REVERSED
}

model OperationalConfig {
  id            String @id @default(uuid()) @db.Uuid
  requestKey    String @unique @db.Uuid
  payloadHash   String
  plantId       String @db.Uuid
  kind          String
  code          String
  revision      Int
  effectiveFrom DateTime
  payload       Json
  evidence      String
  makerId       String @db.Uuid
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedBy    String? @db.Uuid
  verifiedAt    DateTime?
  verificationEvidence String?
  assetRootId   String? @db.Uuid
  assetRoot     OperationalConfig? @relation("OperationalAssetRoot", fields: [assetRootId], references: [id])
  assetVersions OperationalConfig[] @relation("OperationalAssetRoot")
  plant         Plant @relation(fields: [plantId], references: [id])
  mixRuns       OperationalRun[]
  createdAt     DateTime @default(now())
  @@unique([plantId, kind, code, revision])
  @@index([plantId, kind, verificationStatus])
}

model OperationalRun {
  id            String @id @default(uuid()) @db.Uuid
  number        String @unique
  requestKey    String @unique @db.Uuid
  payloadHash   String
  kind          String
  plantId       String @db.Uuid
  effectiveAt   DateTime
  status        OperationalStatus @default(DRAFT)
  payload       Json
  snapshot      Json?
  version       Int @default(1)
  makerId       String @db.Uuid
  submitterId   String? @db.Uuid
  verifierId    String? @db.Uuid
  posterId      String? @db.Uuid
  decisionEvidence String?
  mixVersionId  String? @db.Uuid
  fuelUsageId   String? @db.Uuid
  stockDocumentId String? @unique @db.Uuid
  plant         Plant @relation(fields: [plantId], references: [id])
  mixVersion    OperationalConfig? @relation(fields: [mixVersionId], references: [id])
  fuelUsage     OperationalRun? @relation("RunFuelUsage", fields: [fuelUsageId], references: [id])
  fuelConsumers OperationalRun[] @relation("RunFuelUsage")
  stockDocument StockDocument? @relation(fields: [stockDocumentId], references: [id])
  createdAt     DateTime @default(now())
  @@index([plantId, kind, effectiveAt, status])
}

model StockDocumentLine {
  id            String @id @default(uuid()) @db.Uuid
  documentId    String @db.Uuid
  lineNo        Int
  itemId        String @db.Uuid
  locationId    String @db.Uuid
  destinationId String? @db.Uuid
  quantity      Decimal @db.Decimal(24, 6)
  bookQuantity  Decimal? @db.Decimal(24, 6)
  snapshotHash  String?
  itemName      String
  uomCode       String
  document      StockDocument @relation(fields: [documentId], references: [id])
  item          CatalogItem @relation(fields: [itemId], references: [id])
  location      PlantLocation @relation("StockSourceLocation", fields: [locationId], references: [id])
  destination   PlantLocation? @relation("StockDestinationLocation", fields: [destinationId], references: [id], onDelete: Restrict, map: "stock_destination_fk")
  @@unique([documentId, lineNo])
}

model StockLedgerEntry {
  id           String @id @default(uuid()) @db.Uuid
  sequence     BigInt @unique @default(autoincrement())
  documentId   String @db.Uuid
  eventKey     String @unique
  lineNo       Int
  itemId       String @db.Uuid
  locationId   String @db.Uuid
  uomId        String @db.Uuid
  quantity     Decimal @db.Decimal(24, 6)
  effectiveAt  DateTime
  legacyId     String? @unique @db.Uuid
  sourceRef    String?
  actorId      String @db.Uuid
  createdAt    DateTime @default(now())
  document     StockDocument @relation(fields: [documentId], references: [id])
  item         CatalogItem @relation(fields: [itemId], references: [id])
