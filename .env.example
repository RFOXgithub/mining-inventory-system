# Server-only. For Vercel, use the pooled PostgreSQL connection URL supplied by
# your database provider. Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Server-only. Generate a unique value with at least 32 random characters.
AUTH_SECRET="replace-with-at-least-32-random-characters"
